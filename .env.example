# Local Ollama server and model (no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Per-call timeout; a 3B model on an 8 GB M1 takes ~10-15 s per document
LLM_TIMEOUT_SECONDS=240

# ---- Optional: send the reviewed draft via Gmail / Outlook ----
# Off by default: the exercise requires draft-only. Sending always needs an explicit
# reviewer click plus a confirmation step; it is never automatic.
ENABLE_EMAIL_SEND=false
APP_BASE_URL=http://localhost:8000
# Google Cloud OAuth client (Web application), redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra app registration (Web platform), redirect URI: http://localhost:8000/auth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# Concurrent extraction calls (pair with OLLAMA_NUM_PARALLEL on the Ollama server) and context size
LLM_MAX_PARALLEL=3
LLM_NUM_CTX=4096
